# ============================================================
# Mundo Kids — arquivos que NÃO devem ir para o git
# ============================================================

# --- Segredos / configuração local ---
.env
.env.*
!.env.example
local_settings.py

# --- Dados (bancos, backups, dumps) — contêm dados de clientes ---
*.sqlite3
*.sqlite3-journal
*.sql
*.dump
backup*.json
migration_data*.json

# --- Arquivos enviados e gerados pelo sistema ---
# PDFs/PNGs de orçamentos, logos antigas, backups do dbbackup etc.
/media/
# Gerado pelo "collectstatic" (o WhiteNoise serve a partir dele)
/staticfiles/
# Saídas de scripts de geração de PDF/imagem
/saidas/
# Imagens de teste geradas na raiz do projeto
/confirmacao_*.png
/orcamento_*.png

# --- Pacotes compactados ---
*.zip
*.rar
*.7z

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
.eggs/
build/
dist/
pip-log.txt
pip-delete-this-directory.txt

# --- Ambientes virtuais ---
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
pythonenv*

# --- Testes / cobertura / cache ---
.pytest_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
.cache

# --- Logs ---
*.log

# --- Editores / IDEs ---
.vscode/
.idea/
*.swp
*.swo

# --- Sistema operacional ---
.DS_Store
._*
Thumbs.db
ehthumbs.db
desktop.ini

# --- Vercel ---
.vercel/
